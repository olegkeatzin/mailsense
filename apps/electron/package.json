{
  "name": "mailsense-electron",
  "version": "0.1.4",
  "private": true,
  "description": "Почтовый помощник с ИИ-аналитикой (MailSense)",
  "author": "MailSense",
  "homepage": "https://example.com/mailsense",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "start": "electron .",
    "dist": "electron-builder",
    "server-json": "node scripts/make-server-json.mjs",
    "check-deps": "node scripts/check-deps.mjs",
    "dist:linux": "node scripts/check-deps.mjs && electron-builder --linux --publish never",
    "dist:deb": "node scripts/check-deps.mjs && electron-builder --linux deb --publish never",
    "dist:win": "node scripts/check-deps.mjs && electron-builder --win --publish never",
    "dist:win-nsis": "node scripts/check-deps.mjs && electron-builder --win nsis --publish never",
    "dist:win-portable": "node scripts/check-deps.mjs && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@napi-rs/canvas": "^0.1.65",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "imapflow": "^1.0.172",
    "jszip": "^3.10.1",
    "ldapts": "^9.2.0",
    "mailparser": "^3.7.2",
    "mammoth": "^1.8.0",
    "nodemailer": "9.0.5",
    "openai": "^4.79.1",
    "p-queue": "^8.0.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mailsense/core": "workspace:*",
    "@mailsense/docflow": "workspace:*",
    "@mailsense/server": "workspace:*",
    "@types/node": "^22.10.5",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "ru.mailsense.app",
    "productName": "MailSense",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build-extra",
        "to": "."
      }
    ],
    "extraResources": [
      {
        "from": "../../packages/web/dist",
        "to": "web"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "maintainer": "MailSense <mailsense@example.com>"
    },
    "deb": {
      "afterInstall": "scripts/after-install.sh"
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/canvas-win32-x64-msvc",
          "to": "node_modules/@napi-rs/canvas-win32-x64-msvc"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
