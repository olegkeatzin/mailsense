{
  "name": "@mailsense/server",
  "version": "0.1.3",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mailsense-server": "dist/bin/server.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/server.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/bin/server.ts",
    "start": "node dist/bin/server.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@mailsense/core": "workspace:*",
    "@mailsense/docflow": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2"
  }
}
