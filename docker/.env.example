# Настройки развёртывания MailSense (файл docker/.env).
#
#   cp .env.example .env
#   docker compose -f docker-compose.yml up -d --build
#
# ⚠️ Здесь можно задать всё, что нужно ДО первого запуска: пароль базы, вход администратора,
# адреса ИИ-моделей, часовой пояс, пути данных — и, если нужно, ещё каталог, ящики и роли
# служебных ящиков ниже: тогда контейнер настроится сам, без захода в интерфейс.
#
# Правило одно: значение из окружения применяется ТОЛЬКО там, где настройки ещё нет в базе.
# Заданное администратором в интерфейсе всегда важнее и перезапуском контейнера не отменяется.
#
# Можно не заполнять ничего, кроме обязательного: тогда настройте в интерфейсе после входа
# администратором (Настройки → …):
#   • Каталог (LDAP): адрес контроллера домена, служебная учётная запись, база поиска;
#   • Почта: «Почтовый сервер предприятия» (адрес, порты, шифрование для IMAP/POP3/SMTP) —
#     тогда работник вводит только адрес ящика и пароль; свои ящики каждый заводит сам,
#     роль для этого не нужна (ящик принадлежит человеку, пароль вводит владелец);
#   • Служебные ящики: какая почта внутренняя (делопроизводство), какая внешняя приёмная;
#   • Роли: конструктор прав с нуля — какие действия разрешены роли (галочки);
#   • Пользователи и роли → «Почта для СЭД»: какие адреса работник может выбрать для документов.
# Подробно — docs/deploy-guide.md, разделы «Что задаётся в .env, а что в интерфейсе» и
# «Развёртывание целиком из окружения».

# --- Куда складывать данные (папки на хосте, не тома Docker) ---
# Пути относительны docker/ (там лежит compose-файл). Бэкап = копирование этих каталогов.
# В docker/data: почтовая база SQLite, вложения, ключ шифрования, логи приложения (logs/).
# В docker/pgdata: база документооборота PostgreSQL.
MAILSENSE_DATA_PATH=./data
POSTGRES_DATA_PATH=./pgdata

# --- Часовой пояс предприятия ---
# Определяет, какой сегодня день: сроки, «просрочено», журнал, напоминания.
# Если не задать — возьмётся пояс хоста, а на сервере это часто UTC: тогда с 00:00 до 03:00 МСК
# вчерашний срок выглядит сегодняшним, а «просрочено» приходит на три часа позже.
TZ=Europe/Moscow

# --- База документооборота (обязательно) ---
POSTGRES_DB=mailsense
POSTGRES_USER=mailsense
POSTGRES_PASSWORD=смените-этот-пароль

# --- Вход в систему ---
# Доменные логины (sAMAccountName) через запятую: им выдаётся роль администратора
# при первом входе. Без этого списка администратора не будет ни у кого.
MAILSENSE_ADMIN_LOGINS=
# Аварийный локальный администратор — на случай недоступности контроллера домена.
MAILSENSE_ADMIN_LOGIN=
MAILSENSE_ADMIN_PASSWORD=
# Почта и имя этого администратора — попадут в журнал и в поле «от кого».
MAILSENSE_ADMIN_EMAIL=
MAILSENSE_ADMIN_NAME=
# Документооборот в серверном режиме включается сам на свежей базе (иначе не работает вход,
# а API открыт без аутентификации). Пусто = поведение по умолчанию.
# =false — сервер только с почтой (автовключение подавлено, в базу ничего не пишется);
# =true — включить явно и записать настройку.
MAILSENSE_DOCFLOW_ENABLED=

# --- ИИ-контур (внутренний, облачные провайдеры запрещены) ---
# Выжимка и OCR могут быть на РАЗНЫХ серверах и с разными моделями.
# Пустое значение = «не задано»: OCR тогда идёт на адрес и модель выжимки.
MAILSENSE_AI_BASE_URL=http://100.74.62.22:3006/v1
MAILSENSE_AI_MODEL=Ornith-1.5-9B-Q4_K_M
MAILSENSE_AI_API_KEY=not-needed
MAILSENSE_AI_OCR_BASE_URL=http://100.74.62.22:3010/v1
MAILSENSE_AI_OCR_MODEL=glm-ocr
MAILSENSE_AI_MULTIMODAL=true
MAILSENSE_AI_TIMEOUT_MS=120000
MAILSENSE_AI_OCR_MAX_PAGES=10
MAILSENSE_AI_TEXT_MAX_PAGES=20
# Сколько писем разбирать одновременно. 1 — бережно к слабому серверу ИИ.
MAILSENSE_AI_CONCURRENCY=1
MAILSENSE_OCR_CONCURRENCY=3

# --- Развёртывание из окружения: каталог, ящики, служебные роли (необязательно) ---
# Если заполнить — контейнер настроится сам, заходить в интерфейс не нужно.
# ⚠️ Правило: значение из окружения применяется ТОЛЬКО если этой настройки ещё нет в базе.
# Заданное администратором в интерфейсе всегда важнее и перезапуском НЕ отменяется.
# Пароль каталога хранится зашифрованным; в журнал пароли не попадают.

# Каталог (AD).
# ⚠️ Если каталог поднят на ТОМ ЖЕ хосте (стенд в docker), адрес задавайте как
#    ldap://host.docker.internal:389 — это постоянное имя хоста. IP машины менять нельзя:
#    он меняется при смене сети (Wi-Fi, Tailscale), и контейнер теряет каталог и почту.
# ⚠️ MAILSENSE_LDAP_LOGIN / _PASSWORD — это СЛУЖЕБНАЯ (bind) учётная запись, от имени которой
# приложение читает каталог: ищет сотрудников для выбора исполнителей и наполняет адресную книгу.
# Это НЕ учётные записи сотрудников: каждый входит в систему своей доменной учёткой, и она нигде
# не сохраняется — при входе выполняется отдельная проверка паролем самого работника.
# Без этой учётки адресная книга пуста (поиск идёт только по кэшу), выбирать исполнителей не из чего.
# Ту же учётку можно задать один раз в интерфейсе: Настройки → Каталог (LDAP) → вход в каталог.
MAILSENSE_LDAP_URL=
# ⚠️ База поиска — конкретное OU предприятия, а не корень домена: от корня AD отдаёт referrals
# на CN=Configuration и DNS-зоны, и клиент LDAP падает с «Operations error». Пример: OU=KNIITMU,DC=asup,DC=local
MAILSENSE_LDAP_BASE_DN=
# Формат логина: upn (по умолчанию) | sam | domain | dn.
MAILSENSE_LDAP_LOGIN_FORMAT=
# Суффикс для формата upn. Нужен, когда работник вводит короткий логин (в т. ч. кириллицей),
# например @asup.local — иначе bind уходит без домена и каталог отказывает.
MAILSENSE_LDAP_UPN_SUFFIX=
MAILSENSE_LDAP_LOGIN=
MAILSENSE_LDAP_PASSWORD=
# Проверка сертификата каталога: false (по умолчанию) — принимать self-signed. Включайте true
# только после замены просроченного сертификата, иначе вход в систему сломается.
MAILSENSE_LDAP_REJECT_UNAUTHORIZED=

# Умолчания почтового сервера предприятия (JSON): работник тогда вводит только адрес ящика
# и пароль, а адрес сервера, порты, шифрование и способ входа приходят отсюда. Значение из
# интерфейса (Настройки → Почта) важнее переменной: перезапуск контейнера его не отменяет.
# Пример для MDaemon (прод): POP3 995 SSL и SMTP 465 SSL.
# MAILSENSE_MAIL_DEFAULTS={"pop3":{"host":"192.168.1.10","port":995,"tls":"ssl","authType":"login"},"imap":{"host":"192.168.1.10","port":993,"tls":"ssl","authType":"login"},"smtp":{"host":"192.168.1.10","port":465,"tls":"ssl","authType":"login"}}
MAILSENSE_MAIL_DEFAULTS=

# Почтовые ящики — JSON-массив (можно несколько).
# protocol: imap | pop3;  tls: true/false или none/ssl/starttls (не задано = ssl).
# Пример одной строкой:
# MAILSENSE_MAILBOXES=[{"username":"post@mail.test","password":"секрет","protocol":"imap","host":"mail.test","port":993,"tls":true,"smtpHost":"mail.test","smtpPort":465,"smtpTls":true}]
MAILSENSE_MAILBOXES=

# Роли служебных ящиков — адресами (ищутся среди засеянных):
MAILSENSE_SERVICE_MAILBOX=
MAILSENSE_EXTERNAL_MAILBOX=

# --- ТОЛЬКО ДЛЯ СТЕНДА И РАЗРАБОТКИ ---
# Засев ОДНОГО почтового ящика при первом запуске: приложение создаст его само, чтобы на стенде
# не заводить ящик руками. В боевом развёртывании это не нужно: оставьте false и заводите ящики
# в интерфейсе — они хранятся в базе, а не в переменных окружения.
MAILSENSE_SEED_ACCOUNT=false
MAILSENSE_MAIL_HOST=
MAILSENSE_MAIL_PORT=
MAILSENSE_MAIL_USER=
MAILSENSE_MAIL_PASS=
